{
  "adapter": "seq_image",
  "description": "Acquire and hold all 4 8x8 bar modes from a deterministic round-robin stream (batch_size=1, dwell=1).",
  "evaluation": {
    "eval_output_noise": "clean",
    "kind": "sustained_window",
    "minimum_stable_checks": 5,
    "observations": 24,
    "sampling_contract_version": 1,
    "sampling_law": "enumerated_prior_clean",
    "scoring_weights": "live",
    "thresholds": [
      [
        "hq",
        ">=",
        0.9
      ],
      [
        "modes",
        "==",
        4.0
      ],
      [
        "finite_template_tv",
        "<=",
        0.15
      ]
    ]
  },
  "execution": {
    "host_definition": {
      "dwell": 1,
      "mode": "bars4",
      "width": 16
    },
    "initializer": "deterministic_orthogonal",
    "prior": {
      "kind": "mog",
      "sigma": 0.025,
      "standardize": false
    },
    "prior_contract": "recipe_owned_v1",
    "resources": {
      "batch_size": 1,
      "num_particles": 32,
      "z_dim": 8
    },
    "steps": 480
  },
  "id": "seq_img_round_robin_bars4",
  "resources": {
    "cpu_threads": 1,
    "gpus": 1,
    "timeout_seconds": 300
  },
  "schema_version": 1
}
